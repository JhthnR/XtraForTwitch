<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/thyst_emphasized_decelerate" android:shareInterpolator="true">
    <alpha android:duration="250" android:fromAlpha="0" android:toAlpha="1" />
    <translate android:duration="400" android:fromYDelta="12%" android:toYDelta="0" />
    <scale android:duration="400" android:fromXScale="0.96" android:fromYScale="0.96"
        android:pivotX="50%" android:pivotY="100%" android:toXScale="1" android:toYScale="1" />
</set>
