<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:icon="@drawable/ic_ms_system_update_24"
        android:key="new_version_available"
        android:title="@string/new_version_available"
        app:isPreferenceVisible="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/settings_group_appearance">

        <Preference
            android:icon="@drawable/ic_ms_palette_24"
            android:key="theme_settings"
            android:summary="@string/settings_theme_summary"
            android:title="@string/theme"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_dashboard_24"
            android:key="ui_settings"
            android:summary="@string/settings_ui_summary"
            android:title="@string/ui_settings"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_group_watching">

        <Preference
            android:icon="@drawable/ic_ms_smart_display_24"
            android:key="player_settings"
            android:summary="@string/settings_player_summary"
            android:title="@string/player_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_tune_24"
            android:key="player_button_settings"
            android:summary="@string/settings_player_buttons_summary"
            android:title="@string/player_buttons"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_chat_24"
            android:key="chat_settings"
            android:summary="@string/settings_chat_summary"
            android:title="@string/chat_settings"
            app:singleLineTitle="false" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:icon="@drawable/ic_ms_notifications_24"
            android:key="live_notifications_enabled"
            android:summary="@string/settings_live_notifications_summary"
            android:title="@string/live_notifications"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_download_24"
            android:key="download_settings"
            android:summary="@string/settings_download_summary"
            android:title="@string/download_settings"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_group_network">

        <Preference
            android:icon="@drawable/ic_ms_key_24"
            android:key="api_token_settings"
            android:summary="@string/settings_api_token_summary"
            android:title="@string/api_token_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_video_settings_24"
            android:key="playback_settings"
            android:summary="@string/settings_playback_summary"
            android:title="@string/playback_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_hourglass_empty_24"
            android:key="buffer_settings"
            android:summary="@string/settings_buffer_summary"
            android:title="@string/buffer_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_vpn_lock_24"
            android:key="proxy_settings"
            android:summary="@string/settings_proxy_summary"
            android:title="@string/proxy_settings"
            app:singleLineTitle="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/system_about">

        <Preference
            android:icon="@drawable/ic_ms_update_24"
            android:key="check_updates"
            android:title="@string/check_updates"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_autorenew_24"
            android:key="update_settings"
            android:summary="@string/settings_updater_summary"
            android:title="@string/updater"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_new_releases_24"
            android:key="changelog_settings"
            android:summary="@string/settings_changelog_summary"
            android:title="@string/changelog"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_backup_24"
            android:key="backup_settings"
            android:summary="@string/settings_backup_summary"
            android:title="@string/backup_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_settings_backup_restore_24"
            android:key="restore_settings"
            android:summary="@string/settings_restore_summary"
            android:title="@string/restore_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_bug_report_24"
            android:key="debug_settings"
            android:summary="@string/settings_debug_summary"
            android:title="@string/debug_settings"
            app:singleLineTitle="false" />

        <Preference
            android:icon="@drawable/ic_ms_info_24"
            android:key="about_settings"
            android:title="@string/about"
            app:singleLineTitle="false" />

    </PreferenceCategory>

</androidx.preference.PreferenceScreen>
